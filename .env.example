# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID владельца магазина (число): сюда приходят заказы, ему доступна /admin
# Узнать свой ID можно у бота @userinfobot
ADMIN_ID=

# Путь к файлу базы данных SQLite (создаётся автоматически при первом запуске)
DB_PATH=database/shop.db

# Название магазина (показывается в приветствии)
SHOP_NAME=Demo Coffee

# Адрес самовывоза (показывается клиенту при оформлении заказа)
PICKUP_ADDRESS=ул. Примерная, 1

# Сдвиг времени от UTC в часах (3 = Москва, 5 = Екатеринбург)
TIMEZONE_OFFSET=3